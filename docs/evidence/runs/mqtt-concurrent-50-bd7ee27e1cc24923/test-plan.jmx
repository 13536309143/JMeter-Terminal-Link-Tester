        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="等待订阅就绪" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">long deadline = System.nanoTime() + 15L * 1000000000L
while (!props.get('ll.ready') &amp;&amp; System.nanoTime() &lt; deadline) { Thread.sleep(10) }
if (!props.get('ll.ready')) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('504')
    SampleResult.setResponseMessage('MQTT observer readiness timeout')
} else { SampleResult.setIgnore() }</stringProp>
        </JSR223Sampler>
        <hashTree />
