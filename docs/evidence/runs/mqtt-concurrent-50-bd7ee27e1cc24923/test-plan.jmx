        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化运行状态" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">props.put('ll.finished', new java.util.concurrent.atomic.AtomicInteger(0))
props.put('ll.observed', new java.util.concurrent.atomic.AtomicLong(0))
props.put('ll.ready', false)
props.put('ll.lastFinishNs', System.nanoTime())
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
